generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  SALES
}

enum ContactStatus {
  LEAD
  PROSPECT
  CUSTOMER
  INACTIVE
}

enum DealStage {
  NEW
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

enum ActivityType {
  CALL
  MEETING
  EMAIL
  TASK
  NOTE
}

enum DocumentType {
  QUOTE
  INVOICE
  CREDIT_NOTE
}

enum PaymentMethod {
  TRANSFER
  CHECK
  CASH
  CARD
  DIRECT_DEBIT
  OTHER
}

enum DocumentStatus {
  DRAFT
  SENT
  ACCEPTED
  REFUSED
  PAID
  CANCELLED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(SALES)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  companies          Company[]
  contacts           Contact[]
  deals              Deal[]
  assignedActivities Activity[] @relation("ActivityAssignee")
  createdActivities  Activity[] @relation("ActivityCreator")
  documents          Document[]
  payments           Payment[]
}

/// Profil de l'entreprise utilisatrice (en-tete des devis/factures). Une seule ligne, id = "default".
model Organization {
  id             String   @id @default("default")
  name           String   @default("Mon entreprise")
  legalForm      String?
  taxId          String?
  registryNumber String?
  email          String?
  phone          String?
  address        String?
  city           String?
  country        String?
  currency       String   @default("EUR")
  defaultTaxRate Decimal  @default(20) @db.Decimal(5, 2)
  paymentTerms   Int      @default(30)
  bankDetails    String?
  documentFooter String?
  updatedAt      DateTime @updatedAt
}

model Company {
  id        String   @id @default(cuid())
  name      String
  taxId     String?
  industry  String?
  size      String?
  email     String?
  phone     String?
  website   String?
  address   String?
  city      String?
  country   String?
  notes     String?
  ownerId   String?
  owner     User?    @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contacts   Contact[]
  deals      Deal[]
  activities Activity[]
  documents  Document[]

  @@index([name])
}

model Contact {
  id        String        @id @default(cuid())
  firstName String
  lastName  String
  email     String?
  phone     String?
  position  String?
  status    ContactStatus @default(LEAD)
  source    String?
  notes     String?
  companyId String?
  company   Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  ownerId   String?
  owner     User?         @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  deals      Deal[]
  activities Activity[]
  documents  Document[]

  @@index([lastName])
  @@index([companyId])
}

model Deal {
  id                String    @id @default(cuid())
  title             String
  amount            Decimal   @default(0) @db.Decimal(14, 2)
  stage             DealStage @default(NEW)
  probability       Int       @default(10)
  expectedCloseDate DateTime?
  closedAt          DateTime?
  notes             String?
  companyId         String?
  company           Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contactId         String?
  contact           Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  ownerId           String?
  owner             User?     @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  activities Activity[]
  documents  Document[]

  @@index([stage])
}

model Activity {
  id          String       @id @default(cuid())
  type        ActivityType @default(TASK)
  subject     String
  description String?
  dueDate     DateTime?
  done        Boolean      @default(false)
  completedAt DateTime?
  companyId   String?
  company     Company?     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contactId   String?
  contact     Contact?     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  dealId      String?
  deal        Deal?        @relation(fields: [dealId], references: [id], onDelete: Cascade)
  assigneeId  String?
  assignee    User?        @relation("ActivityAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdById String?
  createdBy   User?        @relation("ActivityCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([assigneeId, done])
  @@index([dueDate])
}

model Document {
  id        String         @id @default(cuid())
  type      DocumentType
  number    String         @unique
  status    DocumentStatus @default(DRAFT)
  issueDate DateTime       @default(now())
  dueDate   DateTime?
  notes     String?
  subtotal  Decimal        @default(0) @db.Decimal(14, 2)
  taxTotal  Decimal        @default(0) @db.Decimal(14, 2)
  total     Decimal        @default(0) @db.Decimal(14, 2)
  companyId String
  company   Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  contactId String?
  contact   Contact?       @relation(fields: [contactId], references: [id], onDelete: SetNull)
  dealId    String?
  deal      Deal?          @relation(fields: [dealId], references: [id], onDelete: SetNull)
  /// Devis d'origine lorsqu'une facture est generee a partir d'un devis
  sourceId  String?
  source    Document?      @relation("DocumentSource", fields: [sourceId], references: [id], onDelete: SetNull)
  derived   Document[]     @relation("DocumentSource")
  /// Somme des paiements enregistrés (factures uniquement)
  amountPaid     Decimal   @default(0) @db.Decimal(14, 2)
  reminderCount  Int       @default(0)
  lastReminderAt DateTime?
  ownerId   String?
  owner     User?          @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  lines    DocumentLine[]
  payments Payment[]

  @@index([type, status])
}

model Payment {
  id          String        @id @default(cuid())
  documentId  String
  document    Document      @relation(fields: [documentId], references: [id], onDelete: Cascade)
  amount      Decimal       @db.Decimal(14, 2)
  date        DateTime      @default(now())
  method      PaymentMethod @default(TRANSFER)
  reference   String?
  notes       String?
  createdById String?
  createdBy   User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime      @default(now())

  @@index([documentId])
  @@index([date])
}

/// Catalogue de produits et prestations, réutilisables dans les devis/factures
model Product {
  id          String   @id @default(cuid())
  name        String
  sku         String?  @unique
  description String?
  unit        String?
  unitPrice   Decimal  @db.Decimal(14, 2)
  taxRate     Decimal  @db.Decimal(5, 2)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([name])
}

model DocumentLine {
  id          String   @id @default(cuid())
  documentId  String
  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  position    Int      @default(0)
  description String
  quantity    Decimal  @db.Decimal(12, 2)
  unitPrice   Decimal  @db.Decimal(14, 2)
  taxRate     Decimal  @db.Decimal(5, 2)
}

/// Compteurs de numerotation (DEV-2026, FAC-2026, ...)
model Counter {
  key   String @id
  value Int
}
